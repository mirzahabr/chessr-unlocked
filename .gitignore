# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Working copy used when folding an edit back into a patch series ─────────
# (docs/repository-layout.md §5). Generated, ~190 MB, never committed.
versions/*/chessr-unlocked-all-features/

# ── Release artifacts (built from versions/, never committed) ────────────────
*.tar.gz
*.zip
dist/

# ── Patch layer rejects (see scripts/build-unlocked.sh) ──────────────────────
*.rej
*.orig

# ── Python tooling ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── Chrome runtime cache — regenerated on load, never source ─────────────────
**/_metadata/

# ── Scratch space and checkpoints ────────────────────────────────────────────
.chessr-re/
